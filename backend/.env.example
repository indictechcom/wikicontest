# WikiEval Environment Configuration
# Copy this file to .env and update the values

# ===========================================================================
# LOCAL DEVELOPMENT (without Docker)
# ===========================================================================

# Database Configuration
# MySQL (recommended for development and production)
DATABASE_URL=mysql+pymysql://root:password@localhost/wikieval

# For SQLite (only for quick testing)
# DATABASE_URL=sqlite:///wikieval.db

# For PostgreSQL (alternative)
# DATABASE_URL=postgresql://username:password@localhost/wikieval

# Security Keys (change these in production!)
SECRET_KEY=wikieval-dev-secret-key-change-in-production
JWT_SECRET_KEY=wikieval-jwt-secret-key-change-in-production

# Application Settings
FLASK_ENV=development
DEBUG=True

# CORS Origins (for frontend development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# ===========================================================================
# TOOLFORGE PRODUCTION
# ===========================================================================
# The following are automatically set by Toolforge - DO NOT set manually:
# TOOL_TOOLSDB_USER - Auto-injected by Toolforge
# TOOL_TOOLSDB_PASSWORD - Auto-injected by Toolforge
# TOOL_TOOLSDB_DBNAME - Optional: defaults to TOOL_NAME
# PORT - Auto-injected by Toolforge

# For Toolforge, set these manually via toolforge env set:
# FLASK_ENV=production
# DEBUG=False
# SECRET_KEY=<generate-secure-key>
# JWT_SECRET_KEY=<generate-secure-key>
# CORS_ORIGINS=https://your-tool.toolforge.org
# OAUTH_CALLBACK_PATH=/oauth/callback
# OAUTH_USE_OOB=True
