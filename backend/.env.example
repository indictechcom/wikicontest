# WikiContest Environment Configuration
# Copy this file to .env and update the values

# ===========================================================================
# DOCKER DEVELOPMENT (docker-compose)
# ===========================================================================
# When using docker-compose, most settings are automatically configured.
# Only OAuth credentials need to be set:

# OAuth 1.0a Configuration (Wikimedia OAuth)
# Create at: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
# Callback URL for Docker: http://localhost:5173/oauth/callback
# OAuth version: 1.0a
# Rights: Basic rights
OAUTH_MWURI=https://meta.wikimedia.org/w/index.php
CONSUMER_KEY=your-consumer-key-here
CONSUMER_SECRET=your-consumer-secret-here
OAUTH_USE_OOB=False

# ===========================================================================
# LOCAL DEVELOPMENT (without Docker)
# ===========================================================================

# Database Configuration
# MySQL (recommended for development and production)
DATABASE_URL=mysql+pymysql://root:password@localhost/wikicontest

# For SQLite (only for quick testing)
# DATABASE_URL=sqlite:///wikicontest.db

# For PostgreSQL (alternative)
# DATABASE_URL=postgresql://username:password@localhost/wikicontest

# Security Keys (change these in production!)
SECRET_KEY=wikicontest-dev-secret-key-change-in-production
JWT_SECRET_KEY=wikicontest-jwt-secret-key-change-in-production

# Application Settings
FLASK_ENV=development
DEBUG=True

# CORS Origins (for frontend development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000

# ===========================================================================
# TOOLFORGE PRODUCTION
# ===========================================================================
# The following are automatically set by Toolforge - DO NOT set manually:
# TOOL_TOOLSDB_USER - Auto-injected by Toolforge
# TOOL_TOOLSDB_PASSWORD - Auto-injected by Toolforge
# TOOL_TOOLSDB_DBNAME - Optional: defaults to TOOL_NAME
# PORT - Auto-injected by Toolforge

# For Toolforge, set these manually via toolforge env set:
# FLASK_ENV=production
# DEBUG=False
# SECRET_KEY=<generate-secure-key>
# JWT_SECRET_KEY=<generate-secure-key>
# CORS_ORIGINS=https://your-tool.toolforge.org
# OAUTH_CALLBACK_PATH=/oauth/callback
# OAUTH_USE_OOB=True
